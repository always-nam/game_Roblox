{
  "name": "tilt-marble-board",
  "version": "1.0.0",
  "private": true,
  "description": "틸트 구슬판 — HTML5/JavaScript 슬라이딩 퍼즐 게임",
  "type": "module",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:e2e": "playwright test",
    "test:live": "BASE_URL=https://always-nam.github.io/game_Roblox/ playwright test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "http-server": "14.1.1"
  }
}
